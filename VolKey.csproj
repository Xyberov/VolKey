<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VolKey</AssemblyName>
    <RootNamespace>VolKey</RootNamespace>
    <Version>1.1.0</Version>
    <Product>VolKey</Product>
    <Company>Xyberov</Company>
    <ApplicationIcon>Assets\VolKey.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\VolKey.ico" LogicalName="VolKey.ico" />
  </ItemGroup>
</Project>
