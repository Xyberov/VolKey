<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VolKey</AssemblyName>
    <RootNamespace>VolKey</RootNamespace>
    <Version>1.5.0</Version>
    <Product>VolKey</Product>
    <Company>Xyberov</Company>
    <ApplicationIcon>Assets\VolKey.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VolKey.Tests" />
    <EmbeddedResource Include="Assets\VolKey.ico" LogicalName="VolKey.ico" />
  </ItemGroup>
</Project>
